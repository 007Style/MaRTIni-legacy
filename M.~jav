  public void actionPerformed(ActionEvent event)
  {
    
    if(event.getActionCommand() == " - Quit - ")
      {
	System.exit(0);
      }
    
    if(event.getActionCommand() == " - Start - ")
      {
	setBackground(Color.red);
      }

    if(event.getActionCommand() == " - Help - ")
      {
	setBackground(Color.blue);
      }
    
    if(event.getActionCommand() == " - About - ")
      {
	setBackground(Color.white);
      }
    
    if(event.getActionCommand() == " - Set Defaults - ")
      {
	setBackground(Color.green);
      }
  }

  
  
  class WindowListener1 extends WindowAdapter
  {
    public void windowClosing(WindowEvent event)
    {
      Window win = event.getWindow();
      win.setVisible(false);
      win.dispose();
      System.exit(0);
    }
  }

